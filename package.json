{
  "name": "oyuncak",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "test": "node tests/run-tests.mjs",
    "functions:check": "node --check functions/index.js && node --check functions/scoreValidation.js",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "check": "npm run lint && npm run functions:check && npm run test && npm run typecheck && npm run build",
    "icons:generate": "node scripts/generate-maskable-icon.mjs",
    "preview": "vite preview",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:build": "npm run build && npx cap sync android",
    "apk:debug": "npm run cap:build && cd android && gradlew assembleDebug",
    "apk:release": "npm run cap:build && cd android && gradlew assembleRelease",
    "test:e2e": "playwright test",
    "test:rules": "npx --yes firebase-tools@15.32.1 emulators:exec --config firebase.emulator.json --project demo-oyuncak --only firestore \"node tests/rules/firestore.mjs\"",
    "test:integration": "npx --yes firebase-tools@15.32.1 emulators:exec --config firebase.emulator.json --project demo-oyuncak --only firestore \"node tests/integration/run.mjs\""
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@radix-ui/react-tooltip": "^1.2.7",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "fabric": "^7.3.1",
    "firebase": "^12.10.0",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.1"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "Safari >= 11",
    "iOS >= 11",
    "Chrome >= 61",
    "Firefox >= 60",
    "Edge >= 16",
    "Samsung >= 8",
    "Android >= 5"
  ],
  "devDependencies": {
    "@capacitor/cli": "^8.2.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "postcss": "^8.5.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^8.3.3",
    "tailwindcss-animate": "^1.0.7"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "xcode": {
      "uuid": "^11.1.1"
    },
    "postcss-selector-parser": "^7.1.6"
  }
}
