{
  "name": "oyuncak",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "test": "node tests/run-tests.mjs",
    "functions:check": "node --check functions/index.js && node --check functions/scoreValidation.js",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "check": "npm run lint && npm run functions:check && npm run test && npm run typecheck && npm run build",
    "icons:generate": "node scripts/generate-maskable-icon.mjs",
    "preview": "vite preview",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:build": "npm run build && npx cap sync android",
    "apk:debug": "npm run cap:build && cd android && gradlew assembleDebug",
    "apk:release": "npm run cap:build && cd android && gradlew assembleRelease",
    "test:e2e": "playwright test",
    "test:rules": "npx --yes firebase-tools@15.29.0 emulators:exec --config firebase.emulator.json --project demo-oyuncak --only firestore \"node tests/rules/firestore.mjs\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@radix-ui/react-tooltip": "^1.2.7",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "fabric": "^7.3.1",
    "firebase": "^12.10.0",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "Safari >= 11",
    "iOS >= 11",
    "Chrome >= 61",
    "Firefox >= 60",
    "Edge >= 16",
    "Samsung >= 8",
    "Android >= 5"
  ],
  "devDependencies": {
    "@capacitor/cli": "^8.2.0",
    "@eslint/js": "^9.32.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-legacy": "^6.1.1",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "postcss": "^8.5.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^6.4.2"
  }
}
