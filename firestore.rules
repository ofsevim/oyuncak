rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Skor: scores/{gameId}/leaderboard/{userId}
    match /scores/{gameId}/leaderboard/{userId} {
      // Liderlik tablosu herkese aÃ§Ä±ktÄ±r. TÃ¼m yazmalar yalnÄ±zca Cloud
