# Service Worker dosyası hiçbir zaman cache'lenmemeli
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# HTML navigasyon yanıtları her zaman taze olmalı
/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

# Hash'li build asset'leri uzun süre cache'lenebilir (Vite zaten hash ekliyor)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
